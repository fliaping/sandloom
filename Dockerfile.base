FROM debian:bookworm-slim AS bubblewrap-builder

ENV BUBBLEWRAP_VERSION=0.11.2 \
    BUBBLEWRAP_SHA256=69abc30005d2186baf7737feacd8da35633b93cf5af38838ecff17c5f8e924f6

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl libcap-dev libseccomp-dev meson ninja-build pkg-config \
    && curl -fsSLo /tmp/bubblewrap.tar.xz \
      "https://github.com/containers/bubblewrap/releases/download/v${BUBBLEWRAP_VERSION}/bubblewrap-${BUBBLEWRAP_VERSION}.tar.xz" \
    && echo "${BUBBLEWRAP_SHA256}  /tmp/bubblewrap.tar.xz" | sha256sum -c - \
    && mkdir /tmp/bubblewrap \
    && tar -xJf /tmp/bubblewrap.tar.xz -C /tmp/bubblewrap --strip-components=1 \
    && meson setup /tmp/bubblewrap/build /tmp/bubblewrap --prefix=/usr \
    && meson compile -C /tmp/bubblewrap/build \
    && meson install -C /tmp/bubblewrap/build

FROM ghcr.io/astral-sh/uv:0.10.10 AS uv

FROM python:3.13-slim-bookworm

LABEL org.opencontainers.image.title="Agent Sandbox Base" \
      org.opencontainers.image.description="Bubblewrap runtime for high-density agent sandboxes"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      bash ca-certificates curl git jq libcap2 libseccomp2 nodejs npm openssh-client \
      procps ripgrep rsync tini util-linux \
    && rm -rf /var/lib/apt/lists/*

COPY --from=bubblewrap-builder /usr/bin/bwrap /usr/bin/bwrap
COPY --from=uv /uv /uvx /usr/local/bin/

RUN test "$(stat -c '%a' /usr/bin/bwrap)" = "755" \
    && test ! -u /usr/bin/bwrap \
    && /usr/bin/bwrap --version \
    && command -v setpriv prlimit python node npm git rg

ENV PATH=/app/.venv/bin:/usr/local/bin:/usr/bin:/bin \
    PYTHONUNBUFFERED=1 \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app
ENTRYPOINT ["/usr/bin/tini", "--"]
