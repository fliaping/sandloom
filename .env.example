# Required API authentication. Generate with: openssl rand -base64 32
SANDBOX_INTERNAL_TOKEN=
SANDBOX_ENVIRONMENT=local
SANDBOX_PORT=8080
# Host-side Compose listener; leave SANDBOX_PORT at 8080 with compose.yaml.
SANDBOX_BIND_ADDRESS=127.0.0.1
SANDBOX_HTTP_PORT=8080
SANDBOX_ADVERTISE_HOST=127.0.0.1
SANDBOX_WORKER_CAPACITY=32
SANDBOX_PROFILE_ID=coding-default
SANDBOX_PROFILE_HASH=bubblewrap-0.11.2-generic-v12

# Bubblewrap capability negotiation: auto, basic, standard, or strict.
# Explicit levels fail startup instead of silently weakening isolation.
SANDBOX_ISOLATION_LEVEL=auto
# Additive capabilities only. PID isolation also requires private procfs.
# Required failures block startup; optional failures are reported and skipped.
# Supported values: pid_namespace,cgroup_namespace (comma-separated or JSON).
SANDBOX_ISOLATION_REQUIRED_FEATURES=
SANDBOX_ISOLATION_OPTIONAL_FEATURES=
# host keeps egress; isolated creates a private network namespace.
SANDBOX_NETWORK_MODE=host
SANDBOX_EXECUTION_BACKEND=bubblewrap

# Metadata: SQLite (single replica), MySQL, or PostgreSQL.
# Compose persists this path in its named volume. For bare Python, use:
# sqlite+aiosqlite:///./data/agent-sandbox.db
SANDBOX_DATABASE_URL=sqlite+aiosqlite:////var/lib/agent-sandbox/control.db
SANDBOX_DATABASE_AUTO_DDL=true
SANDBOX_METADATA_BACKEND=auto
# mysql+aiomysql://user:password@mysql:3306/agent_sandbox
# postgresql+asyncpg://user:password@postgres:5432/agent_sandbox

# Worker registry: memory for one process, redis for multiple replicas.
SANDBOX_REGISTRY_BACKEND=memory
SANDBOX_REGISTRY_NAMESPACE=agent-sandbox
SANDBOX_REDIS_URL=redis://127.0.0.1:6379/0

SANDBOX_LOCAL_ROOT=./data/sandboxes
SANDBOX_SHARED_ROOT=
SANDBOX_IDLE_TTL_SECONDS=1800
# Concurrent commands per sandbox; only executions with a distinct exec_scope
# run in parallel, and an unscoped command stays exclusive.
SANDBOX_MAX_PARALLEL_EXECS_PER_SANDBOX=16
SANDBOX_DISK_HIGH_WATERMARK_PERCENT=90
SANDBOX_MIN_FREE_BYTES=1073741824

# Adjustable template snapshot work budgets, shared by every isolation Level.
# These limit manager work; they are not sandbox CPU/memory/disk quotas.
SANDBOX_TEMPLATE_MAX_EXTRACT_BYTES=8589934592
SANDBOX_TEMPLATE_MAX_ARCHIVE_BYTES=4294967296
SANDBOX_TEMPLATE_SNAPSHOT_MAX_ENTRIES=200000
SANDBOX_TEMPLATE_SNAPSHOT_MAX_DEPTH=128
SANDBOX_TEMPLATE_SNAPSHOT_TIMEOUT_SECONDS=600

# Languages each sandbox is given. The image has to ship them: the base image
# has python and node, and Dockerfile.polyglot adds go, rust, and a JDK.
# All shipped languages work at basic; see docs/TOOLCHAINS.md.
SANDBOX_TOOLCHAINS=python,node

# Runtime package registries and optional outbound proxies.
SANDBOX_HTTP_PROXIES=
SANDBOX_PYTHON_INDEX_URL=https://pypi.org/simple/
SANDBOX_NPM_REGISTRY=https://registry.npmjs.org

# Optional S3-compatible checkpoint store. Empty bucket disables it.
BLOBSTORE_ENDPOINT=
BLOBSTORE_BUCKET=
BLOBSTORE_BASE_PREFIX=agent-sandbox/
BLOBSTORE_REGION=us-east-1
# Standard boto3 credential chain is supported (env, workload identity, etc.).
BLOBSTORE_ACCESS_KEY=
BLOBSTORE_SECRET_KEY=
SANDBOX_OBJECT_STORE_BACKEND=s3
